# Copy this file to .env in the root of your project

# Tells Playwright to use the hermetic browsers
# instead of the system browsers.
# This is useful for CI/CD environments where you want to ensure
# that the same version of the browsers is used across all environments,
# as well as development environments.
# See https://playwright.dev/docs/browsers#hermetic-browsers
# See https://playwright.dev/docs/ci#hermetic-browsers
PLAYWRIGHT_BROWSERS_PATH=0